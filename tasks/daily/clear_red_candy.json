{
	"task": [
		{
			"name": "清红糖",
			"label": "$🍭清红糖",
			"entry": "清红糖_开始",
			"description": "$Resource/descs/daily/clear_red_candy.md",
			"group": [
				"continuous"
			],
			"option": [
				"清红糖-购买红糖",
				"清红糖-预留活动体力",
				"清红糖-心形",
				"清红糖-装备"
			]
		}
	],
	"option": {
		"清红糖-心形": {
			"type": "switch",
			"label": "$清红糖-心形",
			"description": "$直接进行速刷，请手动将关卡推进至最后",
			"cases": [
				{
					"name": "No",
					"pipeline_override": {
						"清红糖_心形开始": {
							"next": "清红糖_心形结束"
						}
					},
					"label": "$No"
				},
				{
					"name": "Yes",
					"option": [
						"清红糖-心形-周期检查",
						"清红糖-心形-种族选择"
					],
					"label": "$Yes"
				}
			]
		},
		"清红糖-心形-周期检查": {
			"type": "switch",
			"label": "$每日仅检查一次",
			"cases": [
				{
					"name": "No",
					"pipeline_override": {
						"清红糖_心形周期检查": {
							"action": "DoNothing"
						}
					},
					"label": "$No"
				},
				{
					"name": "Yes",
					"label": "$Yes"
				}
			]
		},
		"清红糖-心形-种族选择": {
			"type": "select",
			"label": "$种族选择",
			"cases": [
				{
					"name": "龙族",
					"pipeline_override": {
						"清红糖_选择心形种族": {
							"custom_action_param": "t=龙族"
						}
					},
					"label": "$龙族"
				},
				{
					"name": "精灵",
					"pipeline_override": {
						"清红糖_选择心形种族": {
							"custom_action_param": "t=精灵"
						}
					},
					"label": "$精灵"
				},
				{
					"name": "幽灵",
					"pipeline_override": {
						"清红糖_选择心形种族": {
							"custom_action_param": "t=幽灵"
						}
					},
					"label": "$幽灵"
				},
				{
					"name": "仙灵",
					"pipeline_override": {
						"清红糖_选择心形种族": {
							"custom_action_param": "t=仙灵"
						}
					},
					"label": "$仙灵"
				},
				{
					"name": "魔女",
					"pipeline_override": {
						"清红糖_选择心形种族": {
							"custom_action_param": "t=魔女"
						}
					},
					"label": "$魔女"
				},
				{
					"name": "自然灵",
					"pipeline_override": {
						"清红糖_选择心形种族": {
							"custom_action_param": "t=自然灵"
						}
					},
					"label": "$自然灵"
				},
				{
					"name": "兽人",
					"pipeline_override": {
						"清红糖_选择心形种族": {
							"custom_action_param": "t=兽人"
						}
					},
					"label": "$兽人"
				},
				{
					"name": "秘灵",
					"pipeline_override": {
						"清红糖_选择心形种族": {
							"custom_action_param": "t=秘灵"
						}
					},
					"label": "$秘灵"
				}
			]
		},
		"清红糖-装备": {
			"type": "switch",
			"label": "$清红糖-装备",
			"cases": [
				{
					"name": "No",
					"pipeline_override": {
						"清红糖_装备开始": {
							"next": "清红糖_装备结束"
						}
					},
					"label": "$No"
				},
				{
					"name": "Yes",
					"option": [
						"清红糖-装备-模式"
					],
					"label": "$Yes"
				}
			]
		},
		"清红糖-装备-关卡区间": {
			"type": "input",
			"label": "$关卡区间",
			"description": "$设置要清理的红糖关卡区间，每次运行此任务时步进循环",
			"inputs": [
				{
					"name": "起始章节",
					"default": "1",
					"pipeline_type": "string",
					"verify": "^\\d{1,2}$",
					"label": "$起始章节"
				},
				{
					"name": "起始关卡",
					"default": "1",
					"pipeline_type": "string",
					"verify": "^([1-9]|10)$",
					"label": "$起始关卡"
				},
				{
					"name": "结束章节",
					"default": "1",
					"pipeline_type": "string",
					"verify": "^\\d{1,2}$",
					"label": "$结束章节"
				},
				{
					"name": "结束关卡",
					"default": "1",
					"pipeline_type": "string",
					"verify": "^([1-9]|10)$",
					"label": "$结束关卡"
				}
			],
			"pipeline_override": {
				"清红糖_指定关卡作战": {
					"custom_action_param": "sl={起始章节}-{起始关卡}&el={结束章节}-{结束关卡}"
				}
			}
		},
		"清红糖-装备-模式": {
			"type": "select",
			"label": "$清红糖-装备-模式",
			"default_case": "自动刷取",
			"cases": [
				{
					"name": "自动刷取",
					"pipeline_override": {
						"清红糖_装备开始": {
							"next": [
								"装备材料_开始"
							]
						}
					},
					"option": [
						"清红糖-装备-自动刷取-周期检查"
					],
					"description": "$自动刷取最少的装备材料",
					"label": "$自动刷取"
				},
				{
					"name": "关卡区间",
					"option": [
						"清红糖-装备-关卡区间"
					],
					"pipeline_override": {
						"清红糖_装备开始": {
							"next": [
								"清红糖_进入冒险2"
							]
						}
					},
					"description": "$原有手动推进流程：按章节关卡区间步进循环",
					"label": "$关卡区间"
				}
			]
		},
		"清红糖-购买红糖": {
			"type": "switch",
			"label": "$清红糖-购买红糖",
			"description": "$使用水晶叶购买朱珠糖补充体力",
			"cases": [
				{
					"name": "No",
					"pipeline_override": {
						"清红糖_购买红糖": {
							"action": "DoNothing",
							"next": [
								"返回主界面"
							]
						}
					},
					"label": "$No"
				},
				{
					"name": "Yes",
					"option": [
						"清红糖-购买红糖-次数",
						"清红糖-购买红糖-周期检查"
					],
					"label": "$Yes"
				}
			],
			"default_case": "No"
		},
		"清红糖-购买红糖-次数": {
			"type": "input",
			"label": "$购买红糖次数",
			"description": "$今日累计购买次数（不是本次购买次数）：可填 0 表示今日不购买；红糖 0-10，程序会补买到该累计次数，且不超过界面显示的今日上限",
			"inputs": [
				{
					"name": "次数",
					"label": "$次数",
					"default": "0",
					"pipeline_type": "string",
					"verify": "^(10|[0-9])$"
				}
			],
			"pipeline_override": {
				"清红糖_购买红糖": {
					"custom_action_param": "t=red&c={次数}&e=1"
				},
				"清红糖_补糖": {
					"custom_action_param": "t=red&c={次数}"
				}
			}
		},
		"清红糖-装备-自动刷取-周期检查": {
			"type": "switch",
			"label": "$每日仅检查一次",
			"cases": [
				{
					"name": "No",
					"pipeline_override": {
						"装备材料_周期检查": {
							"action": "DoNothing"
						}
					},
					"label": "$No"
				},
				{
					"name": "Yes",
					"label": "$Yes"
				}
			],
			"default_case": "Yes"
		},
		"清红糖-购买红糖-周期检查": {
			"type": "switch",
			"label": "$每日仅检查一次",
			"cases": [
				{
					"name": "No",
					"pipeline_override": {
						"清红糖_购买红糖周期检查": {
							"action": "DoNothing"
						}
					},
					"label": "$No"
				},
				{
					"name": "Yes",
					"label": "$Yes"
				}
			],
			"default_case": "Yes"
		},
		"清红糖-预留活动体力": {
			"type": "switch",
			"label": "$清红糖-预留活动体力",
			"description": "$为每日活动作战预留红糖：开启后自动刷取在体力不足时停止，购买红糖不受限制",
			"cases": [
				{
					"name": "No",
					"pipeline_override": {
						"清红糖_预留设置": {
							"custom_action_param": "r=0"
						}
					},
					"label": "$No"
				},
				{
					"name": "Yes",
					"pipeline_override": {
						"清红糖_预留设置": {
							"custom_action_param": "r=200"
						}
					},
					"label": "$Yes"
				}
			],
			"default_case": "No"
		}
	}
}
