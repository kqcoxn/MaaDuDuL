{
	"task": [
		{
			"name": "圣团巡礼",
			"label": "$⛪圣团巡礼",
			"entry": "圣团巡礼_开始",
			"default_check": true,
			"description": "$Resource/descs/daily/saint_tour.md",
			"group": [
				"continuous"
			],
			"option": [
				"圣团巡礼-收获世界树",
				"圣团巡礼-参观并打扫房间",
				"圣团巡礼-每日冒险",
				"圣团巡礼-每日宴会",
				"圣团巡礼-领取宠物礼物"
			]
		}
	],
	"option": {
		"圣团巡礼-收获世界树": {
			"type": "switch",
			"label": "$收获世界树",
			"cases": [
				{
					"name": "Yes",
					"label": "$Yes"
				},
				{
					"name": "No",
					"pipeline_override": {
						"圣团巡礼_收获世界树开始": {
							"next": "圣团巡礼_收获世界树结束"
						}
					},
					"label": "$No"
				}
			]
		},
		"圣团巡礼-参观并打扫房间": {
			"type": "switch",
			"label": "$每日参观与打扫房间",
			"cases": [
				{
					"name": "Yes",
					"option": [
						"圣团巡礼-参观并打扫房间-每日仅检查一次"
					],
					"label": "$Yes"
				},
				{
					"name": "No",
					"pipeline_override": {
						"圣团巡礼_参观开始": {
							"next": "圣团巡礼_参观结束"
						}
					},
					"label": "$No"
				}
			]
		},
		"圣团巡礼-参观并打扫房间-每日仅检查一次": {
			"type": "switch",
			"label": "$每日仅检查参观一次",
			"cases": [
				{
					"name": "No",
					"pipeline_override": {
						"圣团巡礼_参观周期检查": {
							"action": "DoNothing"
						}
					},
					"label": "$No"
				},
				{
					"name": "Yes",
					"label": "$Yes"
				}
			]
		},
		"圣团巡礼-每日冒险": {
			"type": "switch",
			"label": "$每日冒险（测试阶段）",
			"description": "$测试阶段功能仍不完善，可能出现各类问题，请谨慎使用，若出现 bug 请在群内或 issue 反馈",
			"cases": [
				{
					"name": "No",
					"pipeline_override": {
						"圣团巡礼_冒险开始": {
							"next": "圣团巡礼_冒险结束"
						}
					},
					"label": "$No"
				},
				{
					"name": "Yes",
					"option": [
						"圣团巡礼-每日冒险-每日仅检查一次",
						"圣团巡礼-每日冒险-按熟练度排序",
						"圣团巡礼-每日冒险-狂热优先",
						"圣团巡礼-每日冒险-冒险名单"
					],
					"label": "$Yes"
				}
			]
		},
		"圣团巡礼-每日冒险-每日仅检查一次": {
			"type": "switch",
			"label": "$每日仅检查冒险一次",
			"cases": [
				{
					"name": "No",
					"pipeline_override": {
						"圣团巡礼_冒险周期检查": {
							"action": "DoNothing"
						}
					},
					"label": "$No"
				},
				{
					"name": "Yes",
					"label": "$Yes"
				}
			]
		},
		"圣团巡礼-每日冒险-按熟练度排序": {
			"type": "switch",
			"label": "$按熟练度排序",
			"default_case": "Yes",
			"cases": [
				{
					"name": "Yes",
					"label": "$Yes"
				},
				{
					"name": "No",
					"pipeline_override": {
						"圣团巡礼_确保进入申请界面": {
							"next": "圣团巡礼_开始冒险循环"
						}
					},
					"label": "$No"
				}
			]
		},
		"圣团巡礼-每日冒险-狂热优先": {
			"type": "switch",
			"label": "$优先狂热冒险",
			"description": "$优先选择狂热状态角色，忽视角色列表",
			"cases": [
				{
					"name": "Yes",
					"pipeline_override": {
						"圣团巡礼_开始冒险循环": {
							"next": [
								"圣团巡礼_检查狂热角色",
								"圣团巡礼_查找角色"
							]
						}
					},
					"label": "$Yes"
				},
				{
					"name": "No",
					"pipeline_override": {
						"圣团巡礼_开始冒险循环": {
							"next": [
								"圣团巡礼_查找角色"
							]
						}
					},
					"label": "$No"
				}
			]
		},
		"圣团巡礼-每日冒险-冒险名单": {
			"type": "input",
			"label": "$冒险角色名单",
			"description": "$可填写多个，申请次数不足时自动退出",
			"inputs": [
				{
					"name": "名单",
					"label": "$名单",
					"description": "$设置要邀请的角色，支持模糊搜索（如“锡安”），以顿号/分号/逗号/空格/斜杠分隔",
					"default": "梅露娜、玛丽",
					"pipeline_type": "string"
				}
			],
			"pipeline_override": {
				"圣团巡礼_设置冒险列表": {
					"custom_action_param": "l={名单}"
				}
			}
		},
		"圣团巡礼-每日宴会": {
			"type": "switch",
			"label": "$每日宴会",
			"cases": [
				{
					"name": "No",
					"pipeline_override": {
						"圣团巡礼_宴会开始": {
							"next": "圣团巡礼_宴会结束"
						}
					},
					"label": "$No"
				},
				{
					"name": "Yes",
					"option": [
						"圣团巡礼-每日宴会-周期检查",
						"圣团巡礼-每日宴会-邀请模式"
					],
					"label": "$Yes"
				}
			]
		},
		"圣团巡礼-每日宴会-周期检查": {
			"type": "switch",
			"label": "$每日仅检查一次",
			"cases": [
				{
					"name": "No",
					"pipeline_override": {
						"圣团巡礼_宴会周期检查": {
							"action": "DoNothing"
						}
					},
					"label": "$No"
				},
				{
					"name": "Yes",
					"label": "$Yes"
				}
			]
		},
		"圣团巡礼-每日宴会-邀请模式": {
			"type": "select",
			"label": "$邀请模式",
			"cases": [
				{
					"name": "收藏模式",
					"pipeline_override": {
						"圣团巡礼_进入宴会厅": {
							"next": "圣团巡礼_开始收藏宴会"
						},
						"圣团巡礼_邀请客人开始": {
							"next": "圣团巡礼_邀请客人2"
						}
					},
					"option": [
						"圣团巡礼-每日宴会-收藏数量"
					],
					"label": "$收藏模式"
				},
				{
					"name": "名单模式",
					"pipeline_override": {
						"圣团巡礼_进入宴会厅": {
							"next": "圣团巡礼_开始名单宴会"
						},
						"圣团巡礼_邀请客人开始": {
							"next": "圣团巡礼_初始化客人查找计数"
						}
					},
					"option": [
						"圣团巡礼-每日宴会-邀请名单"
					],
					"label": "$名单模式"
				}
			]
		},
		"圣团巡礼-每日宴会-收藏数量": {
			"type": "input",
			"label": "$收藏数量",
			"description": "$需将需要邀请的角色收藏",
			"inputs": [
				{
					"name": "数量",
					"label": "$数量",
					"description": "$目前仅支持至多 12 个角色",
					"default": "2",
					"pipeline_type": "string",
					"verify": "^\\d+$"
				}
			],
			"pipeline_override": {
				"圣团巡礼_开始收藏宴会": {
					"custom_action_param": "c={数量}"
				}
			}
		},
		"圣团巡礼-每日宴会-邀请名单": {
			"type": "input",
			"label": "$邀请名单",
			"description": "$建议将需要邀请的角色收藏，以提高查找效率",
			"inputs": [
				{
					"name": "名单",
					"label": "$名单",
					"description": "$设置要邀请的角色，支持模糊搜索（如“锡安”），以顿号/分号/逗号/空格/斜杠分隔",
					"default": "梅露娜、玛丽",
					"pipeline_type": "string"
				}
			],
			"pipeline_override": {
				"圣团巡礼_开始名单宴会": {
					"custom_action_param": "invite_list={名单}"
				}
			}
		},
		"圣团巡礼-领取宠物礼物": {
			"type": "switch",
			"label": "$领取宠物礼物",
			"description": "$宠物移动可能较快，若截图延迟较大可能无法点击，请根据个人设备情况决定是否开启此功能",
			"cases": [
				{
					"name": "Yes",
					"option": [
						"圣团巡礼-领取宠物礼物-周期检查"
					],
					"label": "$Yes"
				},
				{
					"name": "No",
					"pipeline_override": {
						"圣团巡礼_宠物礼物开始": {
							"next": "圣团巡礼_宠物礼物结束"
						}
					},
					"label": "$No"
				}
			]
		},
		"圣团巡礼-领取宠物礼物-周期检查": {
			"type": "switch",
			"label": "$每日仅检查一次",
			"cases": [
				{
					"name": "No",
					"pipeline_override": {
						"圣团巡礼_宠物礼物周期检查": {
							"action": "DoNothing"
						}
					},
					"label": "$No"
				},
				{
					"name": "Yes",
					"label": "$Yes"
				}
			]
		}
	}
}
