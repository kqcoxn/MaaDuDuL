{
    "诡计骰子_入场次数": {
        "recognition": {
            "param": {
                "expected": [
                    "入场次数.*[0-9]+\\s*/\\s*[0-9]+",
                    "进场次数.*[0-9]+\\s*/\\s*[0-9]+"
                ]
            }
        }
    },
