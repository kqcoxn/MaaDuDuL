{
	"task": [
		{
			"name": "清紫糖",
			"label": "🪅清紫糖",
			"entry": "清紫糖_开始",
			"description": "Resource/descs/daily/clear_purple_candy.md",
			"option": ["清紫糖-周期检查", "清紫糖-克隆工厂", "清紫糖-副本"]
		}
	],
	"option": {
		"清紫糖-周期检查": {
			"type": "switch",
			"label": "每日仅检查一次",
			"cases": [
				{
					"name": "No",
					"pipeline_override": {
						"清紫糖_周期检查": {
							"action": "DoNothing"
						}
					}
				},
				{
					"name": "Yes"
				}
			]
		},
		"清紫糖-克隆工厂": {
			"type": "switch",
			"label": "克隆工厂作战",
			"cases": [
				{
					"name": "No",
					"pipeline_override": {
						"清紫糖_克隆工厂开始": {
							"next": "清紫糖_克隆工厂结束"
						}
					}
				},
				{
					"name": "Yes",
					"option": ["清紫糖-克隆工厂-选择关卡"]
				}
			]
		},
		"清紫糖-克隆工厂-选择关卡": {
			"type": "input",
			"label": "克隆工厂关卡",
			"description": "请选择可速刷的关卡",
			"inputs": [
				{
					"name": "关卡",
					"label": "克隆工厂关卡",
					"default": "1",
					"pipeline_type": "string",
					"verify": "^\\d+$"
				}
			],
			"pipeline_override": {
				"清紫糖_选择克隆工厂关卡": {
					"custom_action_param": "l={关卡}"
				}
			}
		},
		"清紫糖-副本": {
			"type": "switch",
			"label": "副本作战",
			"cases": [
				{
					"name": "No",
					"pipeline_override": {
						"清紫糖_副本开始": {
							"next": "清紫糖_副本结束"
						}
					}
				},
				{
					"name": "Yes",
					"option": ["清紫糖-副本-选择副本"]
				}
			]
		},
		"清紫糖-副本-选择副本": {
			"type": "select",
			"label": "选择副本",
			"cases": [
				{
					"name": "到手蜡（蜡笔）",
					"pipeline_override": {
						"清紫糖_副本开始": {
							"next": "清紫糖_油画棒"
						}
					},
					"option": ["清紫糖-副本-到手蜡关卡"]
				},
				{
					"name": "糖果自由（棉花糖）",
					"pipeline_override": {
						"清紫糖_副本开始": {
							"next": "清紫糖_糖果自由"
						}
					},
					"option": ["清紫糖-副本-糖果类型"]
				},
				{
					"name": "神秘面包房（魔卡龙）",
					"pipeline_override": {
						"清紫糖_副本开始": {
							"next": "清紫糖_魔卡龙"
						}
					},
					"option": ["清紫糖-副本-面包房关卡"]
				},
				{
					"name": "金币大作战（金币）",
					"pipeline_override": {
						"清紫糖_副本开始": {
							"next": "清紫糖_金币"
						}
					},
					"option": ["清紫糖-副本-金币关卡"]
				}
			]
		},
		"清紫糖-副本-到手蜡关卡": {
			"type": "input",
			"label": "到手蜡关卡",
			"description": "请选择可速刷的关卡",
			"inputs": [
				{
					"name": "关卡",
					"label": "到手蜡关卡",
					"default": "1",
					"pipeline_type": "string",
					"verify": "^\\d+$"
				}
			],
			"pipeline_override": {
				"清紫糖_选择到手蜡关卡": {
					"custom_action_param": "l={关卡}"
				}
			}
		},
		"清紫糖-副本-糖果类型": {
			"type": "select",
			"label": "棉花糖类型",
			"cases": [
				{
					"name": "输出/辅助",
					"pipeline_override": {
						"清紫糖_选择糖果类型": {
							"expected": "防御"
						}
					},
					"option": ["清紫糖-副本-非防御糖果关卡"]
				},
				{
					"name": "防御/辅助",
					"pipeline_override": {
						"清紫糖_选择糖果类型": {
							"expected": "输出"
						}
					},
					"option": ["清紫糖-副本-非输出糖果关卡"]
				},
				{
					"name": "防御/输出",
					"pipeline_override": {
						"清紫糖_选择糖果类型": {
							"expected": "辅助"
						}
					},
					"option": ["清紫糖-副本-非辅助糖果关卡"]
				}
			]
		},
		"清紫糖-副本-非输出糖果关卡": {
			"type": "input",
			"label": "输出/辅助关卡",
			"description": "请选择可速刷的关卡",
			"inputs": [
				{
					"name": "关卡",
					"label": "输出/辅助关卡",
					"default": "1",
					"pipeline_type": "string",
					"verify": "^\\d+$"
				}
			],
			"pipeline_override": {
				"清紫糖_糖果行动": {
					"custom_action_param": "l={关卡}"
				}
			}
		},
		"清紫糖-副本-非防御糖果关卡": {
			"type": "input",
			"label": "防御/辅助关卡",
			"description": "请选择可速刷的关卡",
			"inputs": [
				{
					"name": "关卡",
					"label": "防御/辅助关卡",
					"default": "1",
					"pipeline_type": "string",
					"verify": "^\\d+$"
				}
			],
			"pipeline_override": {
				"清紫糖_糖果行动": {
					"custom_action_param": "l={关卡}"
				}
			}
		},
		"清紫糖-副本-非辅助糖果关卡": {
			"type": "input",
			"label": "防御/输出关卡",
			"description": "请选择可速刷的关卡",
			"inputs": [
				{
					"name": "关卡",
					"label": "防御/输出关卡",
					"default": "1",
					"pipeline_type": "string",
					"verify": "^\\d+$"
				}
			],
			"pipeline_override": {
				"清紫糖_糖果行动": {
					"custom_action_param": "l={关卡}"
				}
			}
		},
		"清紫糖-副本-面包房关卡": {
			"type": "input",
			"label": "面包房关卡",
			"description": "请选择可速刷的关卡",
			"inputs": [
				{
					"name": "关卡",
					"label": "面包房关卡",
					"default": "1",
					"pipeline_type": "string",
					"verify": "^\\d+$"
				}
			],
			"pipeline_override": {
				"清紫糖_面包房行动": {
					"custom_action_param": "l={关卡}"
				}
			}
		},
		"清紫糖-副本-金币关卡": {
			"type": "input",
			"label": "金币关卡",
			"description": "请选择可速刷的关卡，仅支持 13-20 关",
			"inputs": [
				{
					"name": "关卡",
					"label": "金币关卡",
					"default": "13",
					"pipeline_type": "string",
					"verify": "^\\d+$"
				}
			],
			"pipeline_override": {
				"清紫糖_金币行动": {
					"custom_action_param": "l={关卡}"
				}
			}
		}
	}
}
