{
	"task": [
		{
			"name": "游乐场",
			"label": "🎡游乐场",
			"entry": "游乐场_开始",
			"description": "Resource/descs/daily/playground.md",
			"group": ["continuous"],
			"option": ["游乐场-周期检查", "游乐场-作战模式"]
		}
	],
	"option": {
		"游乐场-周期检查": {
			"type": "switch",
			"label": "每日仅检查一次游乐场",
			"cases": [
				{
					"name": "Yes"
				},
				{
					"name": "No",
					"pipeline_override": {
						"游乐场_周期检查": {
							"action": "DoNothing"
						}
					}
				}
			]
		},
		"游乐场-作战模式": {
			"type": "select",
			"label": "作战模式",
			"cases": [
				{
					"name": "日常模式",
					"pipeline_override": {
						"游乐场_进入游乐场": {
							"next": "游乐场_日常模式"
						}
					}
				},
				{
					"name": "循环模式",
					"description": "重复执行，直到手动停止或尝试 30 次",
					"pipeline_override": {
						"游乐场_进入游乐场": {
							"next": "游乐场_循环模式"
						},
						"游乐场_周期检查": {
							"action": "DoNothing"
						}
					}
				}
			]
		}
	}
}
