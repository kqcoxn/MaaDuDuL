{
	"task": [
		{
			"name": "清红糖",
			"label": "$🍭清红糖",
			"entry": "清红糖_开始",
			"description": "$Resource/descs/daily/clear_red_candy.md",
			"group": [
				"continuous"
			],
			"option": [
				"清红糖-心形",
				"清红糖-装备"
			]
		}
	],
	"option": {
		"清红糖-心形": {
			"type": "switch",
			"label": "$清红糖-心形",
			"description": "$直接进行速刷，请手动将关卡推进至最后",
			"cases": [
				{
					"name": "No",
					"pipeline_override": {
						"清红糖_心形开始": {
							"next": "清红糖_心形结束"
						}
					},
					"label": "$No"
				},
				{
					"name": "Yes",
					"option": [
						"清红糖-心形-周期检查",
						"清红糖-心形-种族选择"
					],
					"label": "$Yes"
				}
			]
		},
		"清红糖-心形-周期检查": {
			"type": "switch",
			"label": "$每日仅检查一次",
			"cases": [
				{
					"name": "No",
					"pipeline_override": {
						"清红糖_心形周期检查": {
							"action": "DoNothing"
						}
					},
					"label": "$No"
				},
				{
					"name": "Yes",
					"label": "$Yes"
				}
			]
		},
		"清红糖-心形-种族选择": {
			"type": "select",
			"label": "$种族选择",
			"cases": [
				{
					"name": "龙族",
					"清红糖_选择心形种族": {
						"custom_action_param": "t=龙族"
					},
					"label": "$龙族"
				},
				{
					"name": "精灵",
					"pipeline_override": {
						"清红糖_选择心形种族": {
							"custom_action_param": "t=精灵"
						}
					},
					"label": "$精灵"
				},
				{
					"name": "幽灵",
					"pipeline_override": {
						"清红糖_选择心形种族": {
							"custom_action_param": "t=幽灵"
						}
					},
					"label": "$幽灵"
				},
				{
					"name": "仙灵",
					"pipeline_override": {
						"清红糖_选择心形种族": {
							"custom_action_param": "t=仙灵"
						}
					},
					"label": "$仙灵"
				},
				{
					"name": "魔女",
					"pipeline_override": {
						"清红糖_选择心形种族": {
							"custom_action_param": "t=魔女"
						}
					},
					"label": "$魔女"
				},
				{
					"name": "自然灵",
					"pipeline_override": {
						"清红糖_选择心形种族": {
							"custom_action_param": "t=自然灵"
						}
					},
					"label": "$自然灵"
				},
				{
					"name": "兽人",
					"pipeline_override": {
						"清红糖_选择心形种族": {
							"custom_action_param": "t=兽人"
						}
					},
					"label": "$兽人"
				}
			]
		},
		"清红糖-装备": {
			"type": "switch",
			"label": "$清红糖-装备",
			"cases": [
				{
					"name": "No",
					"pipeline_override": {
						"清红糖_装备开始": {
							"next": "清红糖_装备结束"
						}
					},
					"label": "$No"
				},
				{
					"name": "Yes",
					"option": [
						"清红糖-装备-关卡区间"
					],
					"label": "$Yes"
				}
			]
		},
		"清红糖-装备-关卡区间": {
			"type": "input",
			"label": "$关卡区间",
			"description": "$设置要清理的红糖关卡区间，每次运行此任务时步进循环",
			"inputs": [
				{
					"name": "起始章节",
					"default": "1",
					"pipeline_type": "string",
					"verify": "^\\d{1,2}$",
					"label": "$起始章节"
				},
				{
					"name": "起始关卡",
					"default": "1",
					"pipeline_type": "string",
					"verify": "^([1-9]|10)$",
					"label": "$起始关卡"
				},
				{
					"name": "结束章节",
					"default": "1",
					"pipeline_type": "string",
					"verify": "^\\d{1,2}$",
					"label": "$结束章节"
				},
				{
					"name": "结束关卡",
					"default": "1",
					"pipeline_type": "string",
					"verify": "^([1-9]|10)$",
					"label": "$结束关卡"
				}
			],
			"pipeline_override": {
				"清红糖_指定关卡作战": {
					"custom_action_param": "sl={起始章节}-{起始关卡}&el={结束章节}-{结束关卡}"
				}
			}
		}
	}
}
