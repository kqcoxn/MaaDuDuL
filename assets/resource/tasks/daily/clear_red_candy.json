				},
				{
					"name": "结束关卡",
					"default": "1-1",
					"pipeline_type": "string",
					"verify": "^\\d{1,2}-([1-9]|10)$"
				}
			],
			"pipeline_override": {
				"清红糖_指定关卡作战": {
					"custom_action_param": "sl={起始关卡}&el={结束关卡}"
				}
			}
