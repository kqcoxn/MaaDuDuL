{
	"task": [
		{
			"name": "每日活动作战",
			"label": "🎄大胆放肆的圣诞节【活动】",
			"entry": "每日活动作战_开始",
			"default_check": true,
			"description": "Resource/descs/daily/activity_daily.md",
			"group": [
				"continuous"
			],
			"option": [
				"每日活动作战-周期检查",
				"每日活动作战-作战次数"
			]
		},
		{
			"name": "每日活动作战2",
			"label": "🐸凝聚滴落的回忆之池【活动】",
			"entry": "每日活动作战2_开始",
			"default_check": true,
			"description": "Resource/descs/daily/activity_daily2.md",
			"group": [
				"continuous"
			],
			"option": [
				"每日活动作战-周期检查",
				"每日活动作战-作战次数"
			]
		}
	],
	"option": {
		"每日活动作战-周期检查": {
			"type": "switch",
			"label": "完成后不再检查",
			"description": "当完成 20 次每日作战后，今日不再检查此活动",
			"cases": [
				{
					"name": "No",
					"pipeline_override": {
						"每日活动作战_周期检查": {
							"action": "DoNothing"
						},
						"每日活动作战2_周期检查": {
							"action": "DoNothing"
						}
					}
				},
				{
					"name": "Yes"
				}
			]
		},
		"每日活动作战-作战次数": {
			"type": "select",
			"label": "作战次数",
			"cases": [
				{
					"name": "智能检测",
					"description": "检测是否达到20次，若未达到则使用剩余次数作为作战次数"
				},
				{
					"name": "指定次数",
					"option": [
						"每日活动作战-指定作战次数"
					],
					"pipeline_override": {
						"每日活动作战_检查开始": {
							"next": "每日活动作战_检查结束"
						},
						"每日活动作战2_检查开始": {
							"next": "每日活动作战_检查结束"
						}
					}
				},
				{
					"name": "最大次数",
					"description": "消耗所有红糖用于活动作战",
					"pipeline_override": {
						"每日活动作战_检查开始": {
							"next": "每日活动作战_检查结束"
						},
						"每日活动作战2_检查开始": {
							"next": "每日活动作战_检查结束"
						}
					}
				}
			]
		},
		"每日活动作战-指定作战次数": {
			"type": "input",
			"label": "次数",
			"inputs": [
				{
					"name": "次数",
					"label": "次数",
					"default": "10",
					"pipeline_type": "string",
					"verify": "^\\d+$"
				}
			],
			"pipeline_override": {
				"每日活动作战_速战": {
					"custom_action_param": "t={次数}"
				},
				"每日活动作战2_速战": {
					"custom_action_param": "t={次数}"
				}
			}
		}
	}
}
