{
    "devDependencies": {
        "@nekosu/maa-tools": "1.1.3",
        "@nekosu/prettier-plugin-maafw-sort": "1.1.0",
        "ajv": "8.20.0",
        "ajv-formats": "3.0.1",
        "create-maa-project": "3.7.3",
        "jsonc-parser": "3.3.1",
        "prettier": "3.9.10",
        "prettier-plugin-multiline-arrays": "4.1.11"
    },
    "resolutions": {
        "@modelcontextprotocol/sdk": "1.32.1",
        "body-parser": "2.4.0",
        "http-cache-semantics": "4.3.0",
        "hono": "4.13.11",
        "ip-address": "10.7.4",
        "undici": "6.29.1",
        "zod": "4.6.6"
    },
    "engines": {
        "node": ">=22.13"
    },
    "license": "AGPL-3.0-or-later",
    "name": "maa-dudul",
    "packageManager": "yarn@1.22.22",
    "private": true,
    "scripts": {
        "dev": "yarn dev:prepare && yarn dev:start",
        "dev:prepare": "node tools/dev/run_python.js tools/dev/mfaa.py prepare",
        "dev:start": "node tools/dev/run_python.js tools/dev/mfaa.py start",
        "dev:status": "node tools/dev/run_python.js tools/dev/mfaa.py status",
        "dev:install": "node tools/dev/run_python.js tools/dev/install_mfaa.py",
        "agent": "node tools/dev/run_python.js tools/dev/run_agent.py",
        "agent:check": "uv run --frozen --no-sync python -u agent/local_main.py --check-env",
        "debug": "node tools/dev/run_debugger.js",
        "cmp": "create-maa-project",
        "doctor": "create-maa-project --doctor --report",
        "sync:runtime": "node tools/sync-runtime.mjs",
        "migrate": "node tools/set-version.mjs",
        "versions:sync": "node tools/versions.mjs --sync",
        "versions:check": "node tools/versions.mjs --check",
        "release": "node tools/release.mjs",
        "release:dry-run": "node tools/build-release.mjs --dry-run",
        "check": "yarn versions:check && yarn format:check && yarn check:schema",
        "check:maa": "yarn maa-tools check",
        "check:schema": "node tools/validate-schema.mjs",
        "check:py": "yarn lint:py && yarn typecheck:py",
        "lint:py": "uv run --frozen ruff check .",
        "typecheck:py": "uv run --frozen pyright",
        "format": "prettier --write .",
        "format:check": "prettier --check package.json maa-project.json maatools.config.mts \"tools/*.mjs\" \".vscode/*.json\"",
        "format:py": "uv run --frozen ruff format .",
        "reset": "git reset --soft HEAD~1"
    },
    "version": "1.4.1",
    "type": "module",
    "prettier": {
        "plugins": [
            "prettier-plugin-multiline-arrays"
        ],
        "multilineArraysWrapThreshold": 1,
        "tabWidth": 4,
        "printWidth": 120,
        "useTabs": false,
        "bracketSameLine": true,
        "bracketSpacing": false,
        "endOfLine": "auto",
        "overrides": [
            {
                "files": [
                    "**/*.yml",
                    "**/*.yaml"
                ],
                "options": {
                    "parser": "yaml",
                    "tabWidth": 2
                }
            },
            {
                "files": [
                    "*.json"
                ],
                "options": {
                    "parser": "json",
                    "useTabs": false,
                    "bracketSameLine": false
                }
            }
        ]
    }
}
